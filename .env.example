NODE_ENV=development
PORT=8080
TZ=America/Mexico_City
APP_TIMEZONE=America/Mexico_City

DB_USER=evaluation_app_user
DB_PASSWORD=
DB_NAME=evaluations_app_bd
DB_SOCKET_PATH=/cloudsql/bgk-system:us-central1:bgk-sql-1
# Para desarrollo local, usar DB_HOST/DB_PORT cuando corresponda.
DB_HOST=127.0.0.1
DB_PORT=3306

JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ISSUER=genius-quiz-api

# Temporalmente "*" mientras no exista URL definitiva del frontend.
# Después usar lista separada por comas:
# CORS_ORIGINS=https://quiz.geniuskids.mx,https://admin.geniuskids.mx
CORS_ORIGINS=*

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=direccion@geniuskids.mx
SMTP_PASS=
SMTP_FROM=Genius Quiz <evaluaciones@geniuskids.mx>
SMTP_SECURE=false
